# public/assets is served as-is. Locally it is a symlink to the 410MB repo
# assets tree; before a deploy, scripts/dereference-public-assets.mjs
# (FORCE_DEREF_ASSETS=1) replaces it with the ~80MB runtime set listed in
# scripts/public-assets-manifest.mjs, which is what gets uploaded.

# Local Next verify/output trees are hundreds of MB and are not the app source.
.next
.next/**
.next-verify
.next-verify/**
.next-demo-verify
.next-demo-verify/**
.next-nav-verify
.next-nav-verify/**
.next-*
.next-*/**
tsconfig.tsbuildinfo
